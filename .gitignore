!data/**/README.md
*.dxa

# ----- Large / generated artifacts -----
*.zip
results/**/*.pdf
results/**/*.png
*.pkl
*.joblib

# ----- Python -----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
env/
.python-version

# ----- Notebooks output noise (optional: strip outputs before commit) -----
